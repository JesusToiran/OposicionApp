# Plantilla sin secretos. Copiar a /opt/opositapp/config/.env.prod (0600).
# No usar el .env de desarrollo. Las contraseñas se leen solo de archivos.
APP_IMAGE=oposicionapp:git-REEMPLAZAR_POR_COMMIT
# Digest verificado de postgres:18 para linux/amd64; sin el prefijo postgres@.
POSTGRES_IMAGE_DIGEST=sha256:4ef4dbc939d61acea57712655ddb4b4ab27419c913f94cca0cd57cb3ea3c2280
POSTGRES_DB=oposicionapp
POSTGRES_USER=postgres
APP_DB_USER=oposicionapp_app
FLYWAY_DB_USER=oposicionapp_migrator
JDBC_DATABASE_URL=jdbc:postgresql://postgres:5432/oposicionapp
APP_PUBLIC_ORIGIN=https://mercamento.com

POSTGRES_PASSWORD_FILE=/opt/opositapp/secrets/postgres_password
APP_DB_PASSWORD_FILE=/opt/opositapp/secrets/app_db_password
FLYWAY_DB_PASSWORD_FILE=/opt/opositapp/secrets/flyway_db_password

# Reservadas: no rellenar ni exportar. Producción sustituye el entorno del base.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
FLYWAY_DB_PASSWORD=

# Comprobar colisiones en el anfitrión antes de aprobar esta red.
# El proxy nativo llega por la puerta de enlace de la red web de Docker.
PROXY_NETWORK_SUBNET=172.30.240.0/28
PROXY_NETWORK_GATEWAY=172.30.240.1
TRUSTED_PROXY_CIDR=172.30.240.1/32
